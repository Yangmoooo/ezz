/* ezz 的 Windows 资源：图标、DPI/视觉样式清单、版本信息、密码对话框（设计 §11.1、§12）。
 *
 * 密码对话框用资源模板而不是在代码里摆控件：Tab 导航、Enter 提交、Esc 取消、DPI 缩放
 * 由对话框管理器提供，不需要自己处理键盘与布局（D6）。
 *
 * 版本号由 build.rs 以宏传入（`EZZ_VERSION` / `EZZ_VERSION_COMMA`），唯一来源是
 * Cargo.toml（设计 §11.2）。
 */

#include <windows.h>

#define EZZ_ICON_ID              1
#define EZZ_DIALOG_ID            101
/* 提示与文件名在同一段文字里（设计 §7）：短名字看起来自然，长名字只从句尾省略。 */
#define EZZ_ID_PROMPT            1001
#define EZZ_ID_PASSWORD          1002
#define EZZ_ID_REMEMBER          1003
#define EZZ_ID_KEEP_ORIGINAL     1004
#define EZZ_ID_SHOW_PASSWORD     1005

EZZ_ICON_ID ICON "assets/icon/ezz.ico"

/* RT_MANIFEST = 24。PerMonitorV2 + Common-Controls 6.0。 */
1 24 "assets/hdpi.manifest.xml"

EZZ_ICON_ID VERSIONINFO
  FILEVERSION     EZZ_VERSION_COMMA
  PRODUCTVERSION  EZZ_VERSION_COMMA
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      /* CompanyName 留空：这是个人项目，不虚构一个公司/作者身份。 */
      VALUE "CompanyName",      ""
      VALUE "FileDescription",  "Ezz archive extractor"
      VALUE "FileVersion",      EZZ_VERSION
      VALUE "InternalName",     "ezz"
      VALUE "LegalCopyright",   "LGPL-2.1-or-later"
      VALUE "OriginalFilename", "ezz.exe"
      VALUE "ProductName",      "Ezz"
      VALUE "ProductVersion",   EZZ_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

EZZ_DIALOG_ID DIALOGEX 0, 0, 160, 90
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password required"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  /* 只有提示词，没有文件名（设计 §7）：文件名在通知与日志里，弹窗只问密码。 */
  LTEXT           "", EZZ_ID_PROMPT, 8, 4, 144, 10
  EDITTEXT        EZZ_ID_PASSWORD, 8, 16, 144, 11, ES_PASSWORD | ES_AUTOHSCROLL
  /* `&` 是助记键（Win32 里用 `Alt` + 字母触发，单独敲字母不会生效）：
     Alt+S / Alt+R / Alt+K 切三个勾选项。OK / Cancel 不加：Enter 与 Esc 已经覆盖它们。 */
  CONTROL         "&Show password", EZZ_ID_SHOW_PASSWORD, "Button",
                  BS_AUTOCHECKBOX | WS_TABSTOP, 8, 34, 144, 8
  CONTROL         "&Remember this password", EZZ_ID_REMEMBER, "Button",
                  BS_AUTOCHECKBOX | WS_TABSTOP, 8, 44, 144, 8
  CONTROL         "&Keep the original archive", EZZ_ID_KEEP_ORIGINAL, "Button",
                  BS_AUTOCHECKBOX | WS_TABSTOP, 8, 54, 144, 8
  DEFPUSHBUTTON   "OK", IDOK, 15, 70, 60, 12
  PUSHBUTTON      "Cancel", IDCANCEL, 85, 70, 60, 12
END
