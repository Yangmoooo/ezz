/* ezz 的 Windows 资源：图标、DPI/视觉样式清单、版本信息、密码对话框（设计 §11.1、§12）。
 *
 * 密码对话框用资源模板而不是在代码里摆控件：Tab 导航、Enter 提交、Esc 取消、DPI 缩放
 * 由对话框管理器提供，不需要自己处理键盘与布局（D6）。
 *
 * 版本号由 build.rs 以宏传入（`EZZ_VERSION` / `EZZ_VERSION_COMMA`），唯一来源是
 * Cargo.toml（设计 §11.2）。
 */

#include <windows.h>

#define EZZ_ICON_ID              1
#define EZZ_DIALOG_ID            101
/* 第一行是说明，第二行是文件名（设计 §7）。两行分开，长文件名才不会把说明挤掉。 */
#define EZZ_ID_MESSAGE           1001
#define EZZ_ID_FILENAME          1005
#define EZZ_ID_PASSWORD          1002
#define EZZ_ID_REMEMBER          1003
#define EZZ_ID_KEEP_ORIGINAL     1004

EZZ_ICON_ID ICON "assets/icon/ezz.ico"

/* RT_MANIFEST = 24。PerMonitorV2 + Common-Controls 6.0。 */
1 24 "assets/hdpi.manifest.xml"

EZZ_ICON_ID VERSIONINFO
  FILEVERSION     EZZ_VERSION_COMMA
  PRODUCTVERSION  EZZ_VERSION_COMMA
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "ezz"
      VALUE "FileDescription",  "ezz archive extractor"
      VALUE "FileVersion",      EZZ_VERSION
      VALUE "InternalName",     "ezz"
      VALUE "LegalCopyright",   "LGPL-2.1-or-later"
      VALUE "OriginalFilename", "ezz.exe"
      VALUE "ProductName",      "ezz"
      VALUE "ProductVersion",   EZZ_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

EZZ_DIALOG_ID DIALOGEX 0, 0, 200, 90
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password required"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  LTEXT           "", EZZ_ID_MESSAGE, 8, 4, 184, 10
  /* SS_PATHELLIPSIS：名字太长时由系统从中间省略（保住开头的名称与结尾的扩展名），
     不需要我们按字符数截断，DPI 与字体变化也不会出错。 */
  LTEXT           "", EZZ_ID_MESSAGE, 8, 4, 184, 10
  /* 文件名太长时由系统从中间省略（保住开头的名称与结尾的扩展名）。
     **必须带 SS_LEFTNOWORDWRAP**：自动换行的 static 不省略，只会换行，而第二行会落到
     这个 10 DLU 高的控件外面，看起来就是被截断。 */
  CONTROL         "", EZZ_ID_FILENAME, "Static",
                  SS_LEFTNOWORDWRAP | SS_PATHELLIPSIS | WS_CHILD | WS_VISIBLE,
                  8, 15, 184, 10
  EDITTEXT        EZZ_ID_PASSWORD, 8, 32, 184, 10, ES_PASSWORD | ES_AUTOHSCROLL
  CONTROL         "Remember this password", EZZ_ID_REMEMBER, "Button",
                  BS_AUTOCHECKBOX | WS_TABSTOP, 8, 46, 184, 10
  CONTROL         "Keep the original archive", EZZ_ID_KEEP_ORIGINAL, "Button",
                  BS_AUTOCHECKBOX | WS_TABSTOP, 8, 58, 184, 10
  DEFPUSHBUTTON   "Extract", IDOK, 100, 72, 40, 12
  PUSHBUTTON      "Cancel", IDCANCEL, 144, 72, 40, 12
END
